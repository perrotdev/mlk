<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             Espaces de démonstration — un espace commercialisable est un
             produit de location de type Service rattaché à un Rôle Planning
             (EGP-DEC-010A). Chaque salle physique est un Matériel Planning.
             ============================================================ -->

        <record id="demo_resource_auditorium_a" model="resource.resource">
            <field name="name">Auditorium A</field>
            <field name="resource_type">material</field>
        </record>
        <record id="demo_resource_auditorium_b" model="resource.resource">
            <field name="name">Auditorium B</field>
            <field name="resource_type">material</field>
        </record>
        <record id="demo_role_grand_auditorium" model="planning.role">
            <field name="name">Grand Auditorium</field>
            <field name="resource_ids" eval="[(6, 0, [ref('demo_resource_auditorium_a'), ref('demo_resource_auditorium_b')])]"/>
        </record>
        <record id="demo_product_grand_auditorium" model="product.product">
            <field name="name">Grand Auditorium (Espace)</field>
            <field name="type">service</field>
            <field name="rent_ok" eval="True"/>
            <field name="sale_ok" eval="True"/>
            <field name="planning_enabled" eval="True"/>
            <field name="planning_role_id" ref="demo_role_grand_auditorium"/>
            <field name="list_price">3500.0</field>
        </record>

        <record id="demo_resource_panoramique" model="resource.resource">
            <field name="name">Salle Panoramique</field>
            <field name="resource_type">material</field>
        </record>
        <record id="demo_role_panoramique" model="planning.role">
            <field name="name">Salle Panoramique</field>
            <field name="resource_ids" eval="[(6, 0, [ref('demo_resource_panoramique')])]"/>
        </record>
        <record id="demo_product_panoramique" model="product.product">
            <field name="name">Salle Panoramique (Espace)</field>
            <field name="type">service</field>
            <field name="rent_ok" eval="True"/>
            <field name="sale_ok" eval="True"/>
            <field name="planning_enabled" eval="True"/>
            <field name="planning_role_id" ref="demo_role_panoramique"/>
            <field name="list_price">2200.0</field>
        </record>

        <record id="demo_resource_modulable" model="resource.resource">
            <field name="name">Espace Modulable</field>
            <field name="resource_type">material</field>
        </record>
        <record id="demo_role_modulable" model="planning.role">
            <field name="name">Espace Modulable</field>
            <field name="resource_ids" eval="[(6, 0, [ref('demo_resource_modulable')])]"/>
        </record>
        <record id="demo_product_modulable" model="product.product">
            <field name="name">Espace Modulable (Espace)</field>
            <field name="type">service</field>
            <field name="rent_ok" eval="True"/>
            <field name="sale_ok" eval="True"/>
            <field name="planning_enabled" eval="True"/>
            <field name="planning_role_id" ref="demo_role_modulable"/>
            <field name="list_price">1500.0</field>
        </record>

        <!-- ============================================================
             Rattachement des espaces à des opportunités de démonstration
             définies dans egp_crm (référence qualifiée egp_crm.<id>).
             ============================================================ -->

        <record id="egp_crm.demo_opp_salon_alliance" model="crm.lead">
            <field name="egp_space_ids" eval="[(6, 0, [ref('demo_product_grand_auditorium')])]"/>
            <field name="egp_main_space_id" ref="demo_product_grand_auditorium"/>
        </record>

        <record id="egp_crm.demo_opp_gala_petanque" model="crm.lead">
            <field name="egp_space_ids" eval="[(6, 0, [ref('demo_product_panoramique')])]"/>
            <field name="egp_main_space_id" ref="demo_product_panoramique"/>
        </record>

        <record id="egp_crm.demo_opp_cocktail_astoria" model="crm.lead">
            <field name="egp_space_ids" eval="[(6, 0, [ref('demo_product_modulable')])]"/>
            <field name="egp_main_space_id" ref="demo_product_modulable"/>
            <field name="egp_option_active" eval="True"/>
            <field name="egp_option_start" eval="DateTime.today().strftime('%Y-%m-%d')"/>
            <field name="egp_option_end" eval="(DateTime.today() + relativedelta(days=10)).strftime('%Y-%m-%d')"/>
            <field name="egp_option_space_ids" eval="[(6, 0, [ref('demo_product_modulable')])]"/>
            <field name="egp_option_status">active</field>
            <field name="egp_option_notes">Option posée en attente de validation du budget partenaires.</field>
        </record>

        <record id="egp_crm.demo_opp_congres_vernon" model="crm.lead">
            <field name="egp_space_ids" eval="[(6, 0, [ref('demo_product_grand_auditorium')])]"/>
            <field name="egp_main_space_id" ref="demo_product_grand_auditorium"/>
        </record>

        <!-- ============================================================
             Devis et commandes de location — pour disposer d'un aperçu
             complet du cycle, incluant des réservations effectives.
             ============================================================ -->

        <!-- Devis en cours, non confirmé : aucune réservation posée -->
        <record id="demo_so_salon_alliance" model="sale.order">
            <field name="partner_id" ref="egp_master_data.demo_org_alliance_capital"/>
            <field name="opportunity_id" ref="egp_crm.demo_opp_salon_alliance"/>
            <field name="is_rental_order" eval="True"/>
            <field name="rental_start_date" eval="(DateTime.today() + relativedelta(months=2, days=15)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="rental_return_date" eval="(DateTime.today() + relativedelta(months=2, days=17)).strftime('%Y-%m-%d 18:00:00')"/>
            <field name="order_line" eval="[(0, 0, {
                'product_id': ref('demo_product_grand_auditorium'),
                'product_uom_qty': 1,
                'is_rental': True,
            })]"/>
        </record>

        <!-- Commande de location confirmée : crée une réservation Planning réelle -->
        <record id="demo_so_gala_petanque" model="sale.order">
            <field name="partner_id" ref="egp_master_data.demo_org_petanque_federation"/>
            <field name="opportunity_id" ref="egp_crm.demo_opp_gala_petanque"/>
            <field name="is_rental_order" eval="True"/>
            <field name="rental_start_date" eval="(DateTime.today() + relativedelta(days=45)).strftime('%Y-%m-%d 19:00:00')"/>
            <field name="rental_return_date" eval="(DateTime.today() + relativedelta(days=45)).strftime('%Y-%m-%d 23:59:00')"/>
            <field name="order_line" eval="[(0, 0, {
                'product_id': ref('demo_product_panoramique'),
                'product_uom_qty': 1,
                'is_rental': True,
            })]"/>
        </record>
        <function model="sale.order" name="action_confirm">
            <value eval="[ref('demo_so_gala_petanque')]"/>
        </function>

        <!-- Commande de location confirmée : acompte versé -->
        <record id="demo_so_congres_vernon" model="sale.order">
            <field name="partner_id" ref="egp_master_data.demo_org_mairie_vernon"/>
            <field name="opportunity_id" ref="egp_crm.demo_opp_congres_vernon"/>
            <field name="is_rental_order" eval="True"/>
            <field name="rental_start_date" eval="(DateTime.today() + relativedelta(days=60)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="rental_return_date" eval="(DateTime.today() + relativedelta(days=62)).strftime('%Y-%m-%d 18:00:00')"/>
            <field name="order_line" eval="[(0, 0, {
                'product_id': ref('demo_product_grand_auditorium'),
                'product_uom_qty': 1,
                'is_rental': True,
            })]"/>
        </record>
        <function model="sale.order" name="action_confirm">
            <value eval="[ref('demo_so_congres_vernon')]"/>
        </function>

    </data>
</odoo>
