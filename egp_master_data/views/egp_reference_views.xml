    <record id="view_egp_event_type_search" model="ir.ui.view">
        <field name="name">egp.event.type.search</field>
        <field name="model">egp.event.type</field>
        <field name="arch" type="xml">
            <search string="Types d'événement">
                <field name="complete_name" string="Type d'événement" filter_domain="['|', ('complete_name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="parent_id"/>
                <filter name="filter_categories" string="Catégories" domain="[('parent_id', '=', False)]"/>
                <filter name="filter_archived" string="Archivés" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_parent" string="Catégorie" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

