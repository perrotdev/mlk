<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Vues génériques des référentiels EGP (spécification §9.5).
         Le code est en lecture seule après création : il est utilisé par le
         code métier et ne doit jamais être modifié une fois la valeur utilisée.
         ================================================================ -->

    <record id="view_egp_structure_type_list" model="ir.ui.view">
        <field name="name">egp.structure.type.list</field>
        <field name="model">egp.structure.type</field>
        <field name="arch" type="xml">
            <list string="Types de structure" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" readonly="id"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_egp_structure_type_search" model="ir.ui.view">
        <field name="name">egp.structure.type.search</field>
        <field name="model">egp.structure.type</field>
        <field name="arch" type="xml">
            <search string="Types de structure">
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_archived" string="Archivés" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_egp_structure_type" model="ir.actions.act_window">
        <field name="name">Types de structure</field>
        <field name="res_model">egp.structure.type</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_egp_structure_type_search"/>
    </record>

    <record id="view_egp_business_activity_list" model="ir.ui.view">
        <field name="name">egp.business.activity.list</field>
        <field name="model">egp.business.activity</field>
        <field name="arch" type="xml">
            <list string="Activités principales" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="industry_id"/>
                <field name="name"/>
                <field name="code" readonly="id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_egp_business_activity_search" model="ir.ui.view">
        <field name="name">egp.business.activity.search</field>
        <field name="model">egp.business.activity</field>
        <field name="arch" type="xml">
            <search string="Activités principales">
                <field name="name"/>
                <field name="code"/>
                <field name="industry_id"/>
                <filter name="filter_archived" string="Archivées" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_industry" string="Secteur" context="{'group_by': 'industry_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_egp_business_activity" model="ir.actions.act_window">
        <field name="name">Secteurs et activités</field>
        <field name="res_model">egp.business.activity</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_egp_business_activity_search"/>
        <field name="context">{'search_default_group_by_industry': 1}</field>
    </record>

