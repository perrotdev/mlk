<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_egp_commercial" model="res.groups.privilege">
        <field name="name">EGP Commercial</field>
        <field name="sequence">41</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <!-- Échelle de rôles commerciaux : chaque niveau implique le précédent (§11.2) -->
    <record id="group_egp_prospector" model="res.groups">
        <field name="name">Prospecteur</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_egp_commercial"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('crm.group_use_lead'))]"/>
        <field name="comment">Crée et qualifie ses pistes de prospection sortante.</field>
    </record>

    <record id="group_egp_salesperson" model="res.groups">
        <field name="name">Commercial</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_egp_commercial"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Traite les opportunités qui lui sont affectées et prépare les offres.</field>
    </record>

    <record id="group_egp_sales_manager" model="res.groups">
        <field name="name">Responsable commerciale</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_egp_commercial"/>
        <field name="implied_ids" eval="[(4, ref('group_egp_prospector')),
                                         (4, ref('group_egp_salesperson')),
                                         (4, ref('sales_team.group_sale_manager')),
                                         (4, ref('egp_master_data.group_egp_reference_admin'))]"/>
        <field name="comment">Accès global, affectation, arbitrage et validations commerciales.</field>
    </record>

    <!-- Rôles transverses, cumulables avec l'échelle ci-dessus -->
    <record id="group_egp_adv" model="res.groups">
        <field name="name">EGP / ADV</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Lecture globale des opportunités et mise à jour administrative limitée.</field>
    </record>

    <record id="group_egp_direction" model="res.groups">
        <field name="name">EGP / Direction</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Lecture globale et reporting, sans droit générique d'écriture CRM.</field>
    </record>

    <record id="group_egp_discount_approver" model="res.groups">
        <field name="name">EGP / Approbateurs des remises</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Approuve ou refuse une remise exceptionnelle, sans accès à Studio.</field>
    </record>

    <record id="group_egp_space_manager" model="res.groups">
        <field name="name">EGP / Gestionnaire des espaces</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Administre le catalogue des espaces et supervise les périodes et options.</field>
    </record>

    <!-- EGP-DEC-041 : Responsable commerciale, ADV et Administrateur Odoo sont gestionnaires des espaces -->
    <record id="group_egp_sales_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_egp_space_manager'))]"/>
    </record>
    <record id="group_egp_adv" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_egp_space_manager'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('egp_crm.group_egp_space_manager')),
                                         (4, ref('egp_crm.group_egp_sales_manager'))]"/>
    </record>

</odoo>
