<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_egp_lead_inactivity" model="ir.cron">
            <field name="name">EGP : inactivité des pistes</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_egp_update_lead_inactivity()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <!-- Le cron des échéances d'option est porté par egp_crm_rental (EGP-DEC-010A). -->

        <record id="ir_cron_egp_missing_activity" model="ir.cron">
            <field name="name">EGP : opportunités sans activité planifiée</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_egp_missing_activity_alerts()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

    </data>
</odoo>
